              },
              {
                "kind": "added",
                "text": "    await recordAttempt(payment.id, attempt, result)"
              },
              {
                "kind": "added",
                "text": "    if (result.ok || !result.retryable) return result"
              },
              {
                "kind": "added",
                "text": "    await sleep(delayFor(attempt))"
              },
              {
                "kind": "added",
