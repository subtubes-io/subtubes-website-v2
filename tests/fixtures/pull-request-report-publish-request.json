        ],
        "head": "import { charge } from './charge'\nimport { delayFor, MAX_ATTEMPTS } from './schedule'\nimport { recordAttempt } from '../ledger/attempts'\nimport type { Payment } from './types'\nexport async function collect(payment: Payment) {\n  for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {\n    const result = await charge(payment)\n    await recordAttempt(payment.id, attempt, result)\n    if (result.ok || !result.retryable) return result\n    await sleep(delayFor(attempt))\n  }\n  return { ok: false, retryable: false, reason: 'gave-up' } as const\n}\n"
      },
