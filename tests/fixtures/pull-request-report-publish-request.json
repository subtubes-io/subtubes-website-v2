    "report": {
      "id": "pr_example",
      "title": "Retry failed card charges, and record every attempt",
      "overview": "5 commits by Ada Example and Grace Hopper (`9c9c9c9` to `a0a0a0a`) change 9 files, adding 253 lines and removing 18.\n\nThe branch turns a single charge attempt into a bounded retry loop: it retries failures on a backoff schedule, records each attempt, and gives up cleanly after five. The diagram and scenarios below show the system as it is at `a0a0a0a`, the head of the branch.\n\n**Look first at:** the migration locks the payments table.",
      "themes": [
        {
          "title": "Failed charges are retried",
          "body": "A declined or timed-out charge is retried on an exponential schedule (1, 2, 4, 8 and 16 minutes) and then given up on, instead of failing at once."
        },
        {
          "title": "Every attempt is recorded",
          "body": "Each attempt is a ledger row with its outcome and failure reason, so support can see exactly what happened to a charge."
        },
        {
          "title": "Support can see retries",
          "body": "The admin payment row shows when the next attempt will run."
        },
        {
          "title": "Tests and docs keep up",
          "body": "A fake card network makes the retry paths testable, and the payments doc describes the new flow."
        }
      ],
      "risks": [
        {
          "severity": "high",
          "title": "The migration locks the payments table",
          "body": "Migration 0042 builds an index without CONCURRENTLY, so writes wait while it runs. Build it concurrently or run it in a quiet window."
        },
        {
          "severity": "medium",
          "title": "A refund issued during a retry",
          "body": "Nothing cancels a pending retry when a charge is refunded, so a customer could be charged again after a refund."
        },
        {
          "severity": "low",
          "title": "The card hold is released late",
          "body": "The hold is released only after the final attempt fails, which can be up to 31 minutes after the first."
        }
      ],
      "createdAt": "2026-10-17T23:30:00.000Z",
      "draftedBy": "assistant"
    },
