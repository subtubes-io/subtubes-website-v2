{
  "name": "subtubes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006 --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test-storybook": "playwright test --config=playwright.storybook.config.ts",
    "test-layout": "playwright test --config=playwright.layout.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "content:retire": "tsx scripts/retire-content.ts",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait && npm run db:migrate",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@next/env": "^16.4.0",
    "@vercel/blob": "^2.8.1",
    "better-auth": "^1.7.7",
    "kysely": "^0.28.17",
    "lucide-react": "^0.468.0",
    "next": "16.4.0",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@storybook/addon-docs": "9.1.20",
    "@storybook/nextjs-vite": "9.1.20",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "storybook": "9.1.20",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite": "^6.0.0"
  }
}
