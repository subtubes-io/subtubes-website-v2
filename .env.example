# Copy to .env.local and fill in the secrets. .env.local is never committed.

# Local Postgres from docker-compose.yml (host port 5455).
DATABASE_URL=postgres://subtubes:subtubes@localhost:5455/subtubes

# Optional migration-only connection; defaults to DATABASE_URL locally.
# Supabase: use the transaction pooler for DATABASE_URL on Vercel, and a direct
# connection (or session pooler on IPv4-only networks) for migrations.
# See the deployment section in README.md. Never use NEXT_PUBLIC_ for DB URLs.
DATABASE_MIGRATION_URL=

# Optional PEM root certificate for hosted DB TLS with sslmode=verify-full.
# Set the full certificate value in Vercel; leave empty for local Docker.
DATABASE_SSL_CA=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated exact additional app origins (no wildcards or paths).
BETTER_AUTH_TRUSTED_ORIGINS=

# GitHub OAuth app (https://github.com/settings/developers).
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Vercel Blob store token. Use the DEV store locally/Preview and a
# DIFFERENT store token in Vercel's Production environment. Server-only.
BLOB_READ_WRITE_TOKEN=

# Retained PRIVATE Vercel Blob store credential. Legacy variable name is kept
# for controlled content retirement and future reuse; not exposed to clients.
# Keep separate DEV/Preview and Production stores. Do not deprovision the store.
REPORT_BLOB_READ_WRITE_TOKEN=

# AI API (OpenRouter proxy). See docs/llm-api.md. The service is off unless
# LLM_ENABLED=true and OPENROUTER_API_KEY are both set.
LLM_ENABLED=false
OPENROUTER_API_KEY=
# Optional: price multiplier on OpenRouter cost, service-wide monthly ceiling
# (0 = none), monthly allowance for organizations without a subscription.
LLM_PRICE_MULTIPLIER=2
LLM_GLOBAL_MONTHLY_CEILING_USD=1000
LLM_FREE_MONTHLY_ALLOWANCE_USD=0
# Zero data retention: only providers that keep no prompts. On by default;
# set to false only to allow providers that may retain data.
LLM_REQUIRE_ZDR=true
# Optional rate limits: LLM_RATE_LIMIT_PER_MINUTE (60), LLM_MAX_IN_FLIGHT (4),
# LLM_AUTH_FAILURES_PER_10_MINUTES (20). RATE_LIMIT_BACKEND=off disables them.
RATE_LIMIT_BACKEND=postgres
# Vercel Cron secret for /api/cron/llm-reconcile: openssl rand -hex 32
CRON_SECRET=

# Stripe billing (subscription with an AI allowance, and prepaid credits).
# Webhook endpoint: /api/stripe/webhook (see docs/llm-api.md for the events).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
LLM_PRO_PRICE_USD=39
LLM_PRO_ALLOWANCE_USD=20

# Resend (https://resend.com) sends the newsletter confirmation email. Without a key,
# local development prints the email to the server log; production requires it.
# RESEND_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=Subtubes <news@your-verified-domain.com>

# Membership (monthly and yearly prices, set in lib/membership/plan.ts) uses the Stripe keys above.
# Webhook events to send to /api/stripe/webhook: customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted.
